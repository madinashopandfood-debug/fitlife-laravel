APP_NAME="Fit Life Order System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com
APP_TIMEZONE=Asia/Dhaka

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fitlife
DB_USERNAME=fitlife_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- CORS ---
# Comma separated list of origins allowed to call /api/orders from the
# customer-facing site (e.g. https://fitlifebd.com). Leave as * only for
# quick testing.
FRONTEND_ALLOWED_ORIGINS=*

# --- Encryption for secrets stored in the settings table ---
# APP_KEY above is reused by Laravel's encrypter, which is what actually
# encrypts the Telegram token / CAPI access token at rest (see Setting model).
